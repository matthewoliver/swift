[DEFAULT]
# user = swift
# swift_dir = /etc/swift
#
# log_name = swift
# log_facility = LOG_LOCAL0
# log_level = INFO
# log_address = /dev/log

[ring-manager-builder]
# Poll interval when no queued build job is available.
# interval = 5
#
# Builder locks serialize work on one Swift builder file. The queue still
# preserves FIFO order for overlapping build requests.
# concurrency = 1
# builder_lock_timeout = 600
# build_job_lease_timeout = 3600
#
# This state and artifact configuration must match ring-manager-server.
# ring_manager_state_dir = /etc/swift/ring-manager-state
# ring_artifact_dir = /etc/swift/ring-manager-artifacts
# ring_builder_dir = /etc/swift
#
# Optional best-effort command to run after each state JSON write or delete.
# Use the same command as ring-manager-server when both workers should record
# one external state history. It runs in ring_manager_state_dir and receives
# RING_MANAGER_STATE_ACTION, RING_MANAGER_STATE_DIR,
# RING_MANAGER_STATE_PATH, and RING_MANAGER_STATE_RELPATH.
# ring_manager_state_change_hook =
# ring_manager_state_change_hook_timeout = 30
