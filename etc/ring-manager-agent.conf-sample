[DEFAULT]
# swift_dir = /etc/swift
# user = swift
# You can specify default log routing here if you want:
# log_name = swift
# log_facility = LOG_LOCAL0
# log_level = INFO
# log_address = /dev/log
#
# log_statsd_host =
# log_statsd_port = 8125
# log_statsd_default_sample_rate = 1.0
# log_statsd_sample_rate_factor = 1.0
# log_statsd_metric_prefix =
#
# You can set scheduling priority of processes. Niceness values range from -20
# (most favorable to the process) to 19 (least favorable to the process).
# nice_priority =
#
# You can set I/O scheduling class and priority of processes. I/O niceness
# class values are realtime, best-effort and idle. I/O niceness priority is a
# number which goes from 0 to 7. Work only with ionice_class.
# ionice_class =
# ionice_priority =

[ring-manager-agent]
# Agent operating mode. Enforce mode installs the desired manifest. Observe
# mode only inventories local *.ring.gz files. Validate-only mode compares
# local ring files with one selected release. Observe and validate-only do not
# write under swift_dir.
# mode = enforce
#
# Comma-separated list of ring-manager servers to poll in enforce or
# validate-only mode. Prefer read-only ring-manager servers here so large
# clusters do not all pull from the primary. The agent tries each URL in order
# until one pass succeeds.
# ring_manager_urls = https://ring-ro-1.example.com:6205, https://ring-ro-2.example.com:6205
#
# Release selector required in validate-only mode. Use an immutable release id
# to compare with a known baseline. The special value latest is accepted only
# when following the moving latest pointer is intentional. Do not set release
# in enforce or observe mode.
# release =
#
# Randomize the configured URL order before each sync pass. This can spread
# storage-node pull traffic across equivalent read-only ring-manager servers.
# shuffle_ring_manager_urls = false
#
# In enforce mode, refuse to install a desired manifest older than the manifest
# recorded in the local agent state file. Keep this disabled unless an
# operator is deliberately selecting an older known release for rollback.
# Validate-only never applies this install rollback guard.
# allow_ring_version_rollback = false

# Optional read-only authentication values sent when fetching from
# ring-manager. Prefer read_key for agents so storage nodes do not hold the
# write-capable admin_key.
# read_key =
# read_key_file =
# read_auth_token =
#
# Backward-compatible admin authentication values. Use these only when the
# ring-manager server has not been configured with a read_key.
# admin_key =
# admin_key_file =
# auth_token =
#
# The inline key and key_file options for the same credential are mutually
# exclusive. Secret files are read once at startup and should be regular files
# owned by the service user with restrictive permissions such as 0400 or 0600.
# Root-owned files only work if this process reads them before dropping
# privileges.

# Poll interval and per-cycle jitter in seconds. Jitter reduces thundering herd
# effects when many storage nodes start or wake up together.
# interval = 300
# jitter = 30

# HTTP request timeout in seconds.
# request_timeout = 30

# Maximum time in seconds to wait for the local agent install lock in enforce
# mode. The lock covers manifest download, ring file install, state write, and
# recon update so a daemon pass and a manual --once pass cannot interleave.
# lock_timeout = 10

# Directory where account.ring.gz, container.ring.gz, and object ring files are
# observed, compared, or installed. Usually this should be the same swift_dir
# used by the local Swift storage services. Validate-only reads local ring
# files but does not download artifacts or write in this directory. In enforce
# mode, downloaded replacements are staged here, fsynced, verified, and
# installed with a durable install journal and rollback backups. A leftover
# .ring-manager-agent-install.json is recovered before the next enforce pass;
# leftover *.ring-manager-backup-* files require operator attention.
# swift_dir = /etc/swift

# Recon cache path and local state file. The agent writes
# ring-manager-agent.recon for /recon/ring_manager_agent. Enforce mode stores
# its last installed manifest in state_file. Validate-only does not write this
# state file. Recon includes mode and operator_attention when invalid rings,
# validation differences, a local journal, backups, or filesystem state need
# node-local follow-up.
# recon_cache_path = /var/cache/swift
# state_file = /var/cache/swift/ring-manager-agent-state.json
