[DEFAULT]
# bind_ip = 0.0.0.0
bind_port = 6205
# keep_idle = 600
# bind_timeout = 30
# backlog = 4096
# user = swift
# swift_dir = /etc/swift
# workers = auto
# max_clients = 1024
# log_name = swift
# log_facility = LOG_LOCAL0
# log_level = INFO
# log_address = /dev/log
# log_anonymization_method = MD5
# log_anonymization_salt =
# log_format = {remote_addr} - - [{time.d}/{time.b}/{time.Y}:{time.H}:{time.M}:{time.S} +0000] "{method} {path}" {status} {content_length} "{referer}" "{txn_id}" "{user_agent}" {trans_time:.4f} "{additional_info}" {pid} {policy_index}

[pipeline:main]
pipeline = catch_errors healthcheck recon ring-manager-auth ring-manager-server

[app:ring-manager-server]
use = egg:swift#ring_manager
# set log_name = ring-manager-server
# set log_facility = LOG_LOCAL0
# set log_level = INFO
# set log_address = /dev/log
# set log_requests = true
#
# Ring-manager service mode. A primary accepts reads and writes. Read-only and
# standby servers serve read-only routes and reject mutations.
# ring_manager_mode = primary
#
# Seconds after a successful replica sync before readonly or standby status
# reports published state as stale. This does not block existing read routes.
# ring_manager_sync_freshness_threshold = 300
#
# Directory for Swift-native ring-manager state. Each resource is stored in
# its own JSON file and updates are written atomically and durably.
# ring_manager_state_dir = /etc/swift/ring-manager-state
#
# Optional best-effort command to run after each state JSON write or delete.
# It is split like a shell command but runs without a shell. The command runs
# in ring_manager_state_dir and receives RING_MANAGER_STATE_ACTION,
# RING_MANAGER_STATE_DIR, RING_MANAGER_STATE_PATH, and
# RING_MANAGER_STATE_RELPATH. Use a wrapper script for multi-step work.
# ring_manager_state_change_hook =
#
# Seconds to wait for ring_manager_state_change_hook. Use 0 for no timeout.
# ring_manager_state_change_hook_timeout = 30
#
# Root directory for relative immutable ring artefact paths referenced by
# release manifests. Local paths are never exposed by the API.
# ring_artifact_dir = /etc/swift/ring-manager-artifacts
#
# Root directory for Swift ring-builder files. Standard account, container,
# and object builder names are derived here unless a ring names one builder.
# ring_builder_dir = /etc/swift
#
# Device add and replace requests may set explicit IDs. Builder device arrays
# are dense, so reject pathologically sparse IDs before changing a builder.
# max_explicit_device_id = 1000000
#
# Seconds to wait for the exclusive builder lock used by device CRUD,
# builder-setting updates, and build workers.
# builder_lock_timeout = 600
#
# Build requests are queued for swift-ring-manager-builder by default.
# Set manager only for development and tests, where this WSGI process claims
# jobs with a small in-process worker pool.
# ring_build_executor = external
# ring_build_manager_workers = 1
#
# Claimed build jobs expire if their worker stops refreshing this lease.
# build_job_lease_timeout = 3600
#
# Maximum JSON request body size for ring-manager API requests.
# max_json_request_body_size = 1048576
#
# Maximum number of node IP, replication IP, and device ID selectors accepted
# by one partitions_at_risk request before builder analysis starts.
# max_partitions_at_risk_selectors = 1000

[ring-manager-sync]
# Optional section consumed by swift-ring-manager-sync when it receives this
# config file. CLI options override values here.
#
#   swift-ring-manager-sync /etc/swift/ring-manager-server.conf
#
# Ordered primary and fresh replica sources. A replica must advertise fresh,
# matching published state before the syncer uses it.
# source_urls = https://ring-primary.example.com:6205, https://ring-ro-1.example.com:6205
#
# Local directories populated by the syncer.
# ring_manager_state_dir = /etc/swift/ring-manager-state
# ring_artifact_dir = /etc/swift/ring-manager-artifacts
#
# Optional builder-file sync for promotable standby servers. This downloads
# enabled-ring builder files from admin-only builder endpoints and writes them
# under ring_builder_dir. Disabled-ring builders are skipped by default.
# sync_builder_files = false
# ring_builder_dir = /etc/swift
# request_timeout = 30
# Seconds to wait for the local sync lock before failing the sync attempt.
# sync_lock_timeout = 30
#
# recon_cache_path = /var/cache/swift
# recon_dump = true
#
# Credentials for the remote source. Keep these explicit here; the syncer
# never borrows keys from the local ring-manager-auth filter.
# Builder-file sync requires admin_key_file or auth_token because builders are
# ring-authoring state, not storage-node install artefacts.
# read_key_file = /etc/swift/secrets/ring-manager-read.key
# admin_key_file =
# read_auth_token =
# auth_token =
# state_change_hook =
# state_change_hook_timeout = 30

[filter:ring-manager-auth]
use = egg:swift#ring_manager_auth
#
# Operator token/key accepted in X-Ring-Manager-Admin-Key or X-Auth-Token.
# With no suitable key configured, protected requests fail closed with 503.
# admin_key =
# admin_key_file =
#
# Optional read-only key accepted in X-Ring-Manager-Read-Key or X-Auth-Token
# for GET and HEAD requests. Builder downloads still require the admin key.
# read_key =
# read_key_file =
#
# Inline and file options for one credential are mutually exclusive. Secret
# files are read once at startup and must be regular files owned by root or the
# service user with restrictive permissions such as 0400 or 0600.
#
# Useful for local development only.
# allow_unauthenticated = false

[filter:healthcheck]
use = egg:swift#healthcheck
# disable_path =

[filter:recon]
use = egg:swift#recon
# recon_cache_path = /var/cache/swift

[filter:catch_errors]
use = egg:swift#catch_errors
